<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- AmliFurx's thank-you piece: a bamboo shoot carved from marble, set in an open
       lantern frame. A sculpture first - beauty 800, an Artistic meditation focus -
       and, since the Renew release, a small lamp as well. He wrote it with no light of
       any kind; the comps at the bottom of this def are the one thing here that is not
       his, and they are argued for there and in ATTRIBUTION.md.

       It is the one def of "Fox Lamp Forked" that SydailyFox (Continued) does not
       already ship, which is why this mod exists and why it requires that mod:
       AF_NaturalBuildingBase, AF_Thankyou and both AF_TC_* categories all come from
       there. -->
  <ThingDef ParentName="AF_NaturalBuildingBase">
    <defName>Fox_Lamp</defName>
    <label>Fox Lamp</label>
    <description>A bamboo shoot carved from marble, set in an open lantern frame. Fill the frame and light it, and it throws a small warm pool over whatever is worth looking at nearby.

DO! NOT! EAT! THE! BAMBOO! SHOOT!!!!

--By:AmliFurx
--2020-7-15</description>

    <!-- Vanilla art uses Building_Art, which adds the Beauty line to the inspect
         pane. AF_NaturalBuildingBase leaves thingClass at plain Building, so the
         one stat this piece is built around was the one it never showed. -->
    <thingClass>Building_Art</thingClass>

    <size>(1,1)</size>

    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- Kept as authored. The companion mask Fox_Lampm.png never loaded - see
           ATTRIBUTION.md - and is not shipped; the shader stays so the render is
           unchanged from 1.5. -->
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4.92,4.92)</drawSize>
      <texPath>Thankyou/Fox_Lamp</texPath>
      <shadowData>
        <volume>(0.9,0.3,0.9)</volume>
      </shadowData>
    </graphicData>

    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>

    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>24000</WorkToBuild>
      <MarketValue>200</MarketValue>
      <Beauty>800</Beauty>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
      <MeditationFocusStrength>0.4</MeditationFocusStrength>
    </statBases>

    <costList>
      <BlocksMarble>80</BlocksMarble>
    </costList>

    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <canOverlapZones>false</canOverlapZones>
    <passability>PassThroughOnly</passability>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <constructEffect>ConstructWood</constructEffect>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <techLevel>Neolithic</techLevel>

    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isEdifice>false</isEdifice>
    </building>

    <!-- Draws the lit radius while the piece is being placed, as every vanilla light does. -->
    <placeWorkers>
      <li>PlaceWorker_GlowRadius</li>
    </placeWorkers>

    <inspectorTabs>
      <li>ITab_Art</li>
    </inspectorTabs>

    <comps>
      <!-- No CompQuality, unlike every vanilla art building. That is deliberate on
           the author's part and it works: Frame.CompleteConstruction calls
           CompArt.InitializeArt itself when the finished thing has no quality comp,
           so the piece still gets a generated title, an author and an art tab. The
           trade is that its Beauty and focus strength are flat rather than rolled. -->
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtSculpture</nameMaker>
        <descriptionMaker>ArtDescription_Sculpture</descriptionMaker>
        <canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Artistic</li>
        </focusTypes>
      </li>

      <!-- The lantern burns, as of the Renew release. AmliFurx never gave the piece a
           glower and neither did the 1.5 fork, so this is a change to his work rather
           than a repair of it - see ATTRIBUTION.md. The radius and the fuel are his own
           BambooShootLamp's, the nearest relative and the same subject, so the piece
           behaves like the four lamps it was always filed apart from.

           No CompProperties_HeatPusher, unlike that lamp: a marble sculpture warming a
           room is the one part of this that does not read. No CompProperties_FireOverlay
           either - vanilla draws that flame at the centre of the cell, and this thing is
           drawn at 4.92 cells, so the flame would sit at its foot instead of inside the
           lantern frame.

           Glow, fuel and the switch are wired together by the game, not here:
           CompGlower asks CompRefuelable for fuel and CompFlickable for the switch, the
           way vanilla's TorchBase does. -->
      <li Class="CompProperties_Glower">
        <glowRadius>4.2</glowRadius>
        <glowColor>(227,115,32,0)</glowColor>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.4</fuelConsumptionRate>
        <fuelCapacity>12.0</fuelCapacity>
        <!-- Thirty days to a full tank. A piece that took 24 000 work should not become a
             hauling chore. -->
        <initialFuelPercent>1</initialFuelPercent>
        <fuelFilter>
          <thingDefs>
            <li>Hay</li>
            <li>Chemfuel</li>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <destroyOnNoFuel>false</destroyOnNoFuel>
      </li>
    </comps>

    <thingCategories>
      <li>AF_TC_RimFurry_Building_Thankyou</li>
      <li>AF_TC_RimFurry_Building_Thankyou_Y</li>
    </thingCategories>

    <designationCategory>AF_Thankyou</designationCategory>
    <uiIconPath>Thankyou/UI_Fox_Lamp</uiIconPath>
    <uiIconScale>1.8</uiIconScale>
  </ThingDef>

</Defs>
